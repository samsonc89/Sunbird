---

---

<div id="accordion-open" data-accordion="open" class="mt-4">
  <!-- Question 1 -->

  <h4 id="accordion-open-heading-1" class="mt-4">
    <button
      type="button"
      class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border rounded-lg border-gray-200 dark:border-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 gap-3"
      data-accordion-target="#accordion-open-body-1"
      aria-expanded="false"
      aria-controls="accordion-open-body-1"
    >
      <span class="flex w-full items-center max-md:justify-center">
        Why Parents Choose Sunbird Speech Therapy</span
      >
      <svg
        data-accordion-icon
        class="w-3 h-3 rotate-180 shrink-0"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 10 6"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5 5 1 1 5"></path>
      </svg>
    </button>
  </h4>

  <div
    id="accordion-open-body-1"
    class="hidden"
    aria-labelledby="accordion-open-heading-1"
  >
    <div class="p-5 border border-t-0 border-gray-200 dark:border-gray-700">
      <p class="text-secondary mb-2 text-gray-500 dark:text-gray-400">
        At Sunbird, we transform traditional speech therapy by:
      </p>
      <ul class="ps-5 text-gray-500 list-disc dark:text-gray-400"></ul>
      <li class="mb-2 text-gray-500 dark:text-gray-400 text-xl">
        Teaching you practical strategies to boost your child's communication
        during everyday activities
      </li>
      <li class="mb-2 text-gray-500 dark:text-gray-400 text-xl">
        Creating engaging, play-based sessions that keep your child motivated
      </li>
      <li class="mb-2 text-gray-500 dark:text-gray-400 text-xl">
        Measuring progress with specific, achievable milestones
      </li>
      <li class="mb-2 text-gray-500 dark:text-gray-400 text-xl">
        Providing resources and techniques you can use between sessions
      </li>
    </div>
  </div>

  <!-- Question 2 -->

  <h4 id="accordion-open-heading-2" class="mt-4">
    <button
      type="button"
      class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border rounded-lg border-gray-200 dark:border-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 gap-3"
      data-accordion-target="#accordion-open-body-2"
      aria-expanded="false"
      aria-controls="accordion-open-body-2"
    >
      <span class="flex w-full items-center max-md:justify-center"
        >How are services delivered?</span
      >
      <svg
        data-accordion-icon
        class="w-3 h-3 rotate-180 shrink-0"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 10 6"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5 5 1 1 5"></path>
      </svg>
    </button>
  </h4>
  <div
    id="accordion-open-body-2"
    class="hidden"
    aria-labelledby="accordion-open-heading-2"
  >
    <div
      class="p-5 border border-t-0 border-gray-200 dark:border-gray-700 bg-white"
    >
      <p class="mb-2 text-gray-500 dark:text-gray-400">
        <b>Teletherapy: </b>Available online throughout California.
      </p>
      <p class="mb-2 text-gray-500 dark:text-gray-400">
        <b>In-Home Services: </b>Available in Palo Alto, Mountain View, Menlo
        Park, Los Altos, Atherton, Redwood City, San Carlos, Belmont, and San
        Mateo.
      </p>
      <p>
        <i class="text-lg text-gray-500 dark:text-gray-400"
          >Please schedule a free consultation to see if you’re within our
          service area. Services may also be provided at a mutually convenient
          location.
        </i>
      </p>
    </div>
  </div>

  <!-- Question 3 -->

  <h4 id="accordion-open-heading-3" class="mt-4">
    <button
      type="button"
      class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border rounded-lg border-gray-200 dark:border-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 gap-3"
      data-accordion-target="#accordion-open-body-3"
      aria-expanded="false"
      aria-controls="accordion-open-body-3"
    >
      <span class="flex w-full items-center max-md:justify-center">
        How long are therapy sessions?</span
      >
      <svg
        data-accordion-icon
        class="w-3 h-3 rotate-180 shrink-0"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 10 6"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5 5 1 1 5"></path>
      </svg>
    </button>
  </h4>
  <div
    id="accordion-open-body-3"
    class="hidden"
    aria-labelledby="accordion-open-heading-3"
  >
    <div
      class="p-5 border border-t-0 border-gray-200 dark:border-gray-700 bg-white"
    >
      <p class="mb-2 text-gray-500 dark:text-gray-400">60 minutes.</p>
    </div>
  </div>

  <!-- Question 6 -->

  <h4 id="accordion-open-heading-6" class="mt-4">
    <button
      type="button"
      class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border rounded-lg border-gray-200 dark:border-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 gap-3"
      data-accordion-target="#accordion-open-body-6"
      aria-expanded="false"
      aria-controls="accordion-open-body-6"
    >
      <span class="flex w-full items-center max-md:justify-center">
        What are your rates?</span
      >
      <svg
        data-accordion-icon
        class="w-3 h-3 rotate-180 shrink-0"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 10 6"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5 5 1 1 5"></path>
      </svg>
    </button>
  </h4>
  <div
    id="accordion-open-body-6"
    class="hidden"
    aria-labelledby="accordion-open-heading-6"
  >
    <div
      class="p-5 border border-t-0 border-gray-200 dark:border-gray-700 bg-white"
    >
      <p class="mb-2 text-gray-500 dark:text-gray-400">
        <b>Initial Evaluation: </b>$350
      </p>
      <p class="mb-2 text-gray-500 dark:text-gray-400">
        <b>Individual Therapy Sessions: </b>$200
      </p>
    </div>
  </div>

  <!-- Question 7 -->

  <h4 id="accordion-open-heading-7" class="mt-4">
    <button
      type="button"
      class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border rounded-lg border-gray-200 dark:border-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 gap-3"
      data-accordion-target="#accordion-open-body-7"
      aria-expanded="false"
      aria-controls="accordion-open-body-7"
    >
      <span class="flex w-full items-center max-md:justify-center"
        >Do you accept insurance?</span
      >
      <svg
        data-accordion-icon
        class="w-3 h-3 rotate-180 shrink-0"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 10 6"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5 5 1 1 5"></path>
      </svg>
    </button>
  </h4>
  <div
    id="accordion-open-body-7"
    class="hidden"
    aria-labelledby="accordion-open-heading-7"
  >
    <div
      class="p-5 border border-t-0 border-gray-200 dark:border-gray-700 bg-white"
    >
      <p class="mb-2 text-gray-500 dark:text-gray-400">
        At this time, Sunbird Speech Therapy does not accept insurance.
      </p>
    </div>
  </div>
  <!-- closing tag -->
</div>

<style>
  * {
    /* border: 1px solid red; */
  }
</style>
